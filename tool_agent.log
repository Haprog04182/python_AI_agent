import bpy, math

# Clear current scene (meshes only)
for obj in list(bpy.context.scene.objects):
    bpy.data.objects.remove(obj, do_unlink=True)

M_PLATE = bpy.data.materials.new('OWPlate')
M_PLATE.use_nodes = True
bs = M_PLATE.node_tree.nodes['Principled BSDF']
bs.inputs['Base Color'].default_value = (0.18,0.20,0.24,1.0)
bs.inputs['Metallic'].default_value = 0.6
bs.inputs['Roughness'].default_value = 0.35

M_ACC = bpy.data.materials.new('OWAccent')
M_ACC.use_nodes = True
bs = M_ACC.node_tree.nodes['Principled BSDF']
bs.inputs['Base Color'].default_value = (1.0,0.55,0.12,1.0)
bs.inputs['Metallic'].default_value = 0.3
bs.inputs['Roughness'].default_value = 0.4

M_GLOW = bpy.data.materials.new('OWGlow')
M_GLOW.use_nodes = True
bs = M_GLOW.node_tree.nodes['Principled BSDF']
bs.inputs['Base Color'].default_value = (0.1,0.8,1.0,1.0)
bs.inputs['Emission'].default_value = (0.1,0.8,1.0,1.0)
bs.inputs['Emission Strength'].default_value = 3.5
bs.inputs['Roughness'].default_value = 0.2

M_VISOR = bpy.data.materials.new('OWVisor')
M_VISOR.use_nodes = True
bs = M_VISOR.node_tree.nodes['Principled BSDF']
bs.inputs['Base Color'].default_value = (0.03,0.05,0.08,1.0)
bs.inputs['Roughness'].default_value = 0.1

def add(kind, loc, scale, rot=(0,0,0), mat=None, name=None):
    if kind=='cube':
        bpy.ops.mesh.primitive_cube_add(size=1.0, location=loc)
    elif kind=='sphere':
        bpy.ops.mesh.primitive_uv_sphere_add(segments=24, ring_count=12, radius=1.0, location=loc)
    elif kind=='cyl':
        bpy.ops.mesh.primitive_cylinder_add(vertices=16, radius=1.0, depth=1.0, location=loc)
    elif kind=='cone':
        bpy.ops.mesh.primitive_cone_add(vertices=16, radius1=1.0, radius2=0.0, depth=1.0, location=loc)
    o=bpy.context.active_object
    o.scale=scale
    o.rotation_euler=rot
    if name: o.name=name
    if mat: o.data.materials.append(mat)
    for p in o.data.polygons: p.use_smooth=True
    return o

# Torso
add('cube', (0,0,1.2), (0.7,0.45,0.9), mat=M_PLATE, name='Torso')
add('cube', (0,0,1.2), (0.62,0.38,0.75), mat=M_ACC, name='CoreShell')
add('sphere', (0,0.46,1.2), (0.22,0.08,0.32), mat=M_GLOW, name='ChestCore')

# Head
add('sphere', (0,0,2.35), (0.38,0.35,0.42), mat=M_PLATE, name='Head')
add('cube', (0,0.34,2.35), (0.34,0.12,0.18), mat=M_VISOR, name='Visor')

# Shoulders
add('sphere', (0.85,0,1.85), (0.32,0.30,0.32), mat=M_PLATE, name='ShoulderL')
add('sphere', (-0.85,0,1.85), (0.32,0.30,0.32), mat=M_PLATE, name='ShoulderR')
add('cone', (0,0.0,2.75), (0.18,0.18,0.35), rot=(math.pi,0,0), mat=M_ACC, name='Antenna')

# Arms
for sx in (1,-1):
    add('cyl', (sx*0.95,0,1.35), (0.14,0.14,0.6), mat=M_PLATE, name=f'UpperArm{sx}')
    add('cyl', (sx*0.95,0,0.72), (0.12,0.12,0.55), mat=M_ACC, name=f'LowerArm{sx}')
    add('sphere', (sx*0.95,0,0.42), (0.22,0.20,0.18), mat=M_PLATE, name=f'Hand{sx}')

# Legs
for sx in (0.38,-0.38):
    add('cyl', (sx,0,0.62), (0.16,0.16,0.62), mat=M_PLATE, name=f'UpperLeg{sx}')
    add('cyl', (sx,0,0.05), (0.14,0.14,0.5), mat=M_ACC, name=f'LowerLeg{sx}')
    add('cube', (sx,0.0,-0.25), (0.22,0.30,0.12), mat=M_PLATE, name=f'Foot{sx}')

# Backpack thrusters
add('cyl', (0,-0.5,1.5), (0.18,0.18,0.45), rot=(math.pi/2,0,0), mat=M_PLATE, name='ThrusterL')
add('cyl', (0,0.5,1.5), (0.18,0.18,0.45), rot=(math.pi/2,0,0), mat=M_PLATE, name='ThrusterR')
add('sphere', (0,-0.8,1.5), (0.12,0.12,0.12), mat=M_GLOW, name='GlowL')
add('sphere', (0,0.8,1.5), (0.12,0.12,0.12), mat=M_GLOW, name='GlowR')

# Join all meshes
bpy.ops.object.select_all(action='SELECT')
bpy.context.view_layer.objects.active = bpy.data.objects['Torso']
bpy.ops.object.join()
hero = bpy.context.active_object
hero.name = 'OverwatchHero'

# Bevel smooth look
bpy.ops.object.modifier_add(type='BEVEL')
hero.modifiers['Bevel'].width = 0.03
hero.modifiers['Bevel'].segments = 3
bpy.ops.object.modifier_apply(modifier='Bevel')
bpy.ops.object.shade_smooth()

bpy.ops.object.origin_set(type='ORIGIN_GEOMETRY', center='MEDIAN')
print('CREATED', hero.name, 'verts', len(hero.data.vertices), 'faces', len(hero.data.polygons))
