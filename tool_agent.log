  max-height: 140px; overflow: auto; white-space: pre-wrap; word-break: break-word;
  padding: 6px 8px; border-radius: 6px;
  background: var(--panel-2); border: 1px solid var(--border);
}
.tool .result.error { color: var(--danger); }

/* ===================== COMPOSER ===================== */
.composer {
  border-top: 1px solid var(--border); background: var(--panel);
  backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
  padding: 14px 24px 18px;
}
.composer-inner { display: flex; gap: 10px; align-items: flex-end; max-width: 100%; }
textarea {
  flex: 1; resize: none; min-height: 46px; max-height: 180px;
  padding: 12px 14px; border: 1px solid var(--border-strong);
  border-radius: var(--radius-md); background: var(--panel-solid);
  color: var(--text); font: inherit; outline: none; font-size: 14px;
  font-family: var(--font-sans); line-height: 1.45;
  transition: border-color var(--transition), box-shadow var(--transition);
  scrollbar-width: thin;
}
textarea::placeholder { color: var(--muted); }
textarea:focus {
  border-color: var(--accent); box-shadow: var(--glow);
}
.hint {
  color: var(--muted); font-size: 12px; margin-top: 8px;
  font-family: var(--font-mono); letter-spacing: 0.2px;
  display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
}
.kbd {
  display: inline-block; padding: 1px 6px; border-radius: 4px;
  border: 1px solid var(--border-strong); background: var(--panel-solid);
  font-size: 11px; color: var(--muted);
}

/* ===================== MODAL ===================== */
.modal {
  position: fixed; inset: 0; z-index: 1000;
  background: rgba(2, 6, 23, 0.65);
  backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
  display: grid; place-items: center;
  padding: 20px; animation: fadeIn 160ms ease-out;
}
.modal.hidden { display: none; }
.modal-card {
  width: min(960px, 96vw); max-height: 88vh;
  background: var(--panel-solid); border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow), 0 0 0 1px rgba(255,255,255,0.04) inset;
  display: flex; flex-direction: column; overflow: hidden;
  animation: popIn 200ms ease-out;
}
@keyframes popIn {
  from { opacity: 0; transform: scale(0.96) translateY(10px); }
  to { opacity: 1; transform: none; }
}
.modal-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 14px 18px; border-bottom: 1px solid var(--border);
  background: var(--panel);
  backdrop-filter: blur(8px);
}
.modal-head h2 { margin: 0; font-size: 16px; font-weight: 700; color: var(--text-strong); }
.modal-body {
  margin: 0; padding: 18px; overflow: auto;
  white-space: pre-wrap; word-break: break-word;
  font-family: var(--font-mono); font-size: 13px; line-height: 1.5;
  color: var(--text); background: var(--panel-solid);
  scrollbar-width: thin;
}

/* ===================== RESPONSIVE ===================== */
@media (max-width: 720px) {
  .topbar { padding: 12px 16px; gap: 10px; }
  .brand .logo { width: 40px; height: 40px; font-size: 20px; }
  h1 { font-size: 17px; }
  .subtitle { display: none; }
  .chat { padding: 18px 14px 12px; gap: 16px; }
  .bubble { max-width: 92%; padding: 12px 14px; }
  .avatar { width: 34px; height: 34px; font-size: 16px; }
  .composer { padding: 10px 16px 14px; }
  .btn { padding: 7px 11px; font-size: 12px; }
  .modal-card { width: 98vw; max-height: 92vh; border-radius: var(--radius-md); }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
}

/* focus for keyboard users globally */
:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px; }
