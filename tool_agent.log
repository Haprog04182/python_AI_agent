import subprocess,re
out=subprocess.check_output(['convert','preview.jpg','txt:-'],text=True)
def stats(th):
    pts=[]; cs=[0,0,0]; n=0
    for ln in out.splitlines():
        m=re.match(r'^(\d+),(\d+): \(([^)]+)\)', ln)
        if not m: continue
        x=int(m.group(1)); y=int(m.group(2))
        v=[float(x) for x in m.group(3).split(',')]
        if sum(v)/3 < th:
            n+=1; pts.append((x,y)); cs=[cs[i]+v[i] for i in range(3)]
    if n==0: return
    xs=[p[0] for p in pts]; ys=[p[1] for p in pts]
    print("th",th,"n",n,"bbox",(min(xs),min(ys),max(xs),max(ys)),"avg",[c/n for c in cs])
for th in [100,120,150,180]:
    stats(th)
