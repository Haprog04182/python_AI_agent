import bpy

out_blend = "/home/teacher_haprog/PyCharmMiscProject/python_AI_agent/generated_models/dark_souls_chest.blend"
out_glb = "/home/teacher_haprog/PyCharmMiscProject/python_AI_agent/generated_models/dark_souls_chest.glb"

bpy.ops.wm.read_factory_settings(use_empty=True)

def make_material(name, rgba, roughness=0.65, metallic=0.0, noise_scale=None, accent=None):
    mat = bpy.data.materials.new(name=name)
    mat.use_nodes = True
    nt = mat.node_tree
    bsdf = nt.nodes.get("Principled BSDF")
    if bsdf:
        bsdf.inputs["Base Color"].default_value = rgba
        bsdf.inputs["Roughness"].default_value = roughness
        bsdf.inputs["Metallic"].default_value = metallic
    # optional noise-driven weathering
    if noise_scale:
        noise = nt.nodes.new("ShaderNodeTexNoise")
        noise.inputs["Scale"].default_value = noise_scale
        noise.location = (-300, 0)
        colorramp = nt.nodes.new("ShaderNodeValToRGB")
        colorramp.location = (-100, 0)
        if accent:
            colorramp.color_ramp.elements[0].color = rgba
            colorramp.color_ramp.elements[1].color = accent
        mix = nt.nodes.new("ShaderNodeMixRGB")
        mix.location = (0, 0)
        mix.blend_type = 'MIX'
        mix.inputs["Fac"].default_value = 0.35
        nt.links.new(noise.outputs["Fac"], colorramp.inputs["Fac"])
        nt.links.new(colorramp.outputs["Color"], mix.inputs["Color2"])
        bsdf_col = bsdf.inputs["Base Color"]
        nt.links.new(bsdf_col, mix.inputs["Color1"]) if False else None
        # connect original base as color1
        # create rgb input from constant
        rgb = nt.nodes.new("ShaderNodeRGB")
        rgb.outputs[0].default_value = rgba
        rgb.location = (-200, -150)
        nt.links.new(rgb.outputs["Color"], mix.inputs["Color1"])
        nt.links.new(mix.outputs["Color"], bsdf.inputs["Base Color"])
    return mat

def add_cube(loc, size, mat, name=None, smooth=False):
    bpy.ops.mesh.primitive_cube_add(size=1, location=loc)
    obj = bpy.context.active_object
    if name:
        obj.name = name
    obj.scale = size
    obj.data.materials.append(mat)
    if smooth:
        bpy.ops.object.shade_smooth()
    return obj

