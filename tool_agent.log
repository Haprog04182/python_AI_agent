import bpy

out_blend = "/home/teacher_haprog/PyCharmMiscProject/python_AI_agent/generated_models/rpg_chest.blend"
out_glb = "/home/teacher_haprog/PyCharmMiscProject/python_AI_agent/generated_models/rpg_chest.glb"

bpy.ops.wm.read_factory_settings(use_empty=True)

def make_material(name, rgba, roughness=0.6, metallic=0.0):
    mat = bpy.data.materials.new(name=name)
    mat.use_nodes = True
    bsdf = mat.node_tree.nodes.get("Principled BSDF")
    if bsdf:
        bsdf.inputs["Base Color"].default_value = rgba
        bsdf.inputs["Roughness"].default_value = roughness
        bsdf.inputs["Metallic"].default_value = metallic
    return mat

def add_cube(loc, size, mat, name=None, smooth=True):
    bpy.ops.mesh.primitive_cube_add(size=1, location=loc)
    obj = bpy.context.active_object
    if name:
        obj.name = name
    obj.scale = size
    obj.data.materials.append(mat)
    if smooth:
        bpy.ops.object.shade_smooth()
    return obj

wood = make_material("Wood", (0.38, 0.24, 0.14, 1.0), 0.75, 0.05)
darkwood = make_material("DarkWood", (0.24, 0.14, 0.08, 1.0), 0.85, 0.0)
metal = make_material("Metal", (0.25, 0.22, 0.20, 1.0), 0.35, 0.9)
gold = make_material("Gold", (0.75, 0.58, 0.25, 1.0), 0.3, 0.95)

# Body
body = add_cube((0, 0, 0.45), (1.15, 0.72, 0.90), wood, "ChestBody")

# Rounded/overhanging lid
bpy.ops.mesh.primitive_cube_add(size=1, location=(0, 0, 1.02))
lid = bpy.context.active_object
lid.name = "ChestLid"
lid.scale = (1.28, 0.80, 0.24)
lid.data.materials.append(wood)
bpy.ops.object.shade_smooth()
bev = lid.modifiers.new(name="Bevel", type="BEVEL")
bev.width = 0.04
bev.segments = 4

# Horizontal bands
for z in (0.18, 0.46, 0.78):
    add_cube((0, 0, z), (1.18, 0.75, 0.05), metal, f"Band_{z}", smooth=False)
# Front/back extra girth (narrow plates)
for y in (-0.37, 0.37):
    add_cube((0, y, 0.46), (1.16, 0.03, 0.20), metal, f"FrontBand_{y}", smooth=False)

# Vertical corner posts
for x in (-0.52, 0.52):
    for y in (-0.31, 0.31):
        add_cube((x, y, 0.46), (0.09, 0.09, 0.92), metal, "CornerPost", smooth=False)

# Lock plate and keyhole
lock = add_cube((0, -0.38, 0.50), (0.26, 0.04, 0.34), gold, "LockPlate")
add_cube((0, -0.395, 0.52), (0.08, 0.02, 0.12), darkwood, "Keyhole", smooth=False)

# Handle
add_cube((0, 0, 1.16), (0.35, 0.08, 0.06), metal, "HandleBar", smooth=False)
add_cube((0, 0, 1.10), (0.30, 0.03, 0.12), metal, "HandleMount", smooth=False)

# Hinges on back
for x in (-0.40, 0.0, 0.40):
    add_cube((x, 0.36, 0.93), (0.14, 0.05, 0.10), metal, "Hinge", smooth=False)

# Decorative studs along bands
for x in (-0.45, -0.15, 0.15, 0.45):
    for z in (0.18, 0.78):
        bpy.ops.mesh.primitive_uv_sphere_add(radius=0.035, location=(x, -0.37, z))
        stud = bpy.context.active_object
        stud.name = "Stud"
        stud.data.materials.append(metal)
        bpy.ops.object.shade_smooth()

bpy.ops.wm.save_as_mainfile(filepath=out_blend)
bpy.ops.export_scene.gltf(filepath=out_glb, export_format='GLB')
print("done", out_blend, out_glb)
