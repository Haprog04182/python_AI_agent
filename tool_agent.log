pivot.matrix_parent_inverse = staff.matrix_world.inverted() @ pivot.matrix_world
# set pivot world location to top of staff by local offset
pivot.location = (0,0,1.2)
# parent orb to staff
orb.parent = staff
orb.matrix_parent_inverse = staff.matrix_world.inverted() @ orb.matrix_world
orb.location = (0,0,1.15)
