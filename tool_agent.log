}

/* ---------- Light theme ---------- */
[data-theme="light"] {
  --bg: #f5f7fb;
  --bg-grad: radial-gradient(1200px 800px at 10% -10%, rgba(99, 102, 241, 0.10), transparent 60%),
             radial-gradient(900px 600px at 110% 10%, rgba(56, 189, 248, 0.08), transparent 55%),
             #f5f7fb;
  --panel: rgba(255, 255, 255, 0.78);
  --panel-2: rgba(241, 245, 249, 0.85);
