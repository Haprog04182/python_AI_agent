.chat::-webkit-scrollbar-thumb:hover { background: var(--accent); }

.empty-state {
  margin: auto; max-width: 520px; text-align: center; padding: 40px 20px;
  color: var(--muted);
}
.empty-state .big { font-size: 52px; margin-bottom: 12px; opacity: 0.7; }
.empty-state h3 { margin: 0 0 8px; color: var(--text-strong); font-size: 20px; }
.empty-state p { margin: 0 0 16px; font-size: 14px; }
.chips { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin-top: 12px; }
.chip {
