const chatEl = document.getElementById('chat');
const inputEl = document.getElementById('input');
const sendBtn = document.getElementById('sendBtn');
const statusLine = document.getElementById('statusLine');
const configLine = document.getElementById('configLine');
const modal = document.getElementById('modal');
const modalTitle = document.getElementById('modalTitle');
const modalBody = document.getElementById('modalBody');
const modalClose = document.getElementById('modalClose');

const sessionId = (localStorage.getItem('sessionId') || crypto.randomUUID());
localStorage.setItem('sessionId', sessionId);

let isStreaming = false;

function escapeHtml(s) {
  return String(s)
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;');
}

function simpleMarkdown(text) {
  // Fenced code blocks
  text = text.replace(/```(\w*)\n([\s\S]*?)```/g, (_, lang, code) =>
    `<pre><code class="lang-${escapeHtml(lang)}">${escapeHtml(code.trim())}</code></pre>`);
  // Inline code
  text = text.replace(/`([^`]+)`/g, (_, code) => `<code>${escapeHtml(code)}</code>`);
  // Bold
  text = text.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
  // Italic
  text = text.replace(/(?<!\*)\*(?!\*)(.+?)(?<!\*)\*(?!\*)/g, '<em>$1</em>');
  // Line breaks
  text = text.replace(/\n/g, '<br>');
  return text;
}

function addMessage(role, content = '') {
  const msg = document.createElement('div');
  msg.className = `msg ${role}`;
  const avatar = document.createElement('div');
  avatar.className = 'avatar';
  avatar.textContent = role === 'user' ? '🧑' : '🤖';
  const bubble = document.createElement('div');
  bubble.className = 'bubble';
  bubble.innerHTML = simpleMarkdown(escapeHtml ? '' : '') ; // placeholder
  bubble.textContent = content;
  msg.appendChild(avatar);
  msg.appendChild(bubble);
  chatEl.appendChild(msg);
  chatEl.scrollTop = chatEl.scrollHeight;
  return { msg, bubble };
}

function setBubbleContent(bubble, text) {
  bubble.innerHTML = simpleMarkdown(text);
  chatEl.scrollTop = chatEl.scrollHeight;
}

function addActivityContainer(bubble) {
  const act = document.createElement('div');
  act.className = 'activity';
  act.innerHTML = '<span class="status-chip">инструменты</span>';
  bubble.appendChild(act);
  return act;
}

function addToolCard(activity, name, args) {
  const card = document.createElement('div');
  card.className = 'tool';
  const argsPreview = JSON.stringify(args || {});
  card.innerHTML = `
    <div class="name">🔧 ${escapeHtml(name)}</div>
    <div class="args">${escapeHtml(argsPreview.length > 240 ? argsPreview.slice(0, 240) + '…' : argsPreview)}</div>
    <div class="result" data-result>выполняется…</div>
  `;
  activity.appendChild(card);
  return card;
}

async function loadConfig() {
  try {
    const res = await fetch('/api/config');
    const data = await res.json();
    configLine.textContent = `${data.model} @ ${data.ollama_host}`;
  } catch (e) {
    configLine.textContent = 'Ollama недоступен?';
  }
  try {
    const res = await fetch('/api/tools');
    const data = await res.json();
    statusLine.textContent = 'Инструменты: ' + (data.tools || []).join(', ');
  } catch (e) {}
}

function openModal(title, body) {
  modalTitle.textContent = title;
  modalBody.textContent = body;
  modal.classList.remove('hidden');
}
modalClose.addEventListener('click', () => modal.classList.add('hidden'));
modal.addEventListener('click', (e) => { if (e.target === modal) modal.classList.add('hidden'); });

document.getElementById('toolsBtn').addEventListener('click', async () => {
  const res = await fetch('/api/tools');
  const data = await res.json();
  openModal('Доступные инструменты', (data.tools || []).join('\n'));
});
document.getElementById('historyBtn').addEventListener('click', async () => {
  const res = await fetch(`/api/history?session_id=${encodeURIComponent(sessionId)}`);
  const data = await res.json();
  const lines = (data.messages || []).map(m => `${m.role}: ${m.content}`).join('\n\n');
  openModal('История диалога', lines || '(пусто)');
});
document.getElementById('clearBtn').addEventListener('click', async () => {
  await fetch('/api/clear', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({session_id: sessionId}) });
  chatEl.innerHTML = '';
  statusLine.textContent = 'История очищена.';
});
document.getElementById('saveBtn').addEventListener('click', async () => {
  const res = await fetch('/api/save', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({session_id: sessionId}) });
  const data = await res.json();
  statusLine.textContent = data.status || 'Сохранено';
});

async function send() {
  if (isStreaming) return;
  const text = inputEl.value.trim();
  if (!text) return;
  inputEl.value = '';
  isStreaming = true;
  sendBtn.disabled = true;

  const userMsg = addMessage('user', text);
  const asst = addMessage('assistant', '');
  const activity = addActivityContainer(asst.bubble);
  let toolCards = new Map();
  let finalText = '';
  let hasActivity = true;

  statusLine.textContent = 'Агент думает…';

  try {
    const res = await fetch('/api/chat/stream', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ session_id: sessionId, message: text }),
    });
    if (!res.ok || !res.body) {
      throw new Error(`HTTP ${res.status}`);
    }
    const reader = res.body.getReader();
    const decoder = new TextDecoder();
    let buffer = '';
    while (true) {
      const { value, done } = await reader.read();
      if (done) break;
      buffer += decoder.decode(value, { stream: true });
      // обработка событий SSE
      let idx;
      while ((idx = buffer.indexOf('\n\n')) !== -1) {
        const chunk = buffer.slice(0, idx);
        buffer = buffer.slice(idx + 2);
        const lines = chunk.split('\n');
        let event = 'message';
        let dataStr = '';
        for (const line of lines) {
          if (line.startsWith('event:')) event = line.slice(6).trim();
          else if (line.startsWith('data:')) dataStr += line.slice(5).trim();
        }
        if (!dataStr) continue;
        let data;
        try { data = JSON.parse(dataStr); } catch { data = { raw: dataStr }; }
        handleEvent(event, data, asst, activity, toolCards);
      }
    }
  } catch (e) {
    setBubbleContent(asst.bubble, `Ошибка: ${e.message}`);
  } finally {
    // убрать пустую activity, если инструментов не было
    if (activity && !activity.querySelector('.tool')) {
      activity.remove();
    }
    isStreaming = false;
    sendBtn.disabled = false;
    statusLine.textContent = 'Готов к работе.';
  }
}

function handleEvent(event, data, asst, activity, toolCards) {
  if (event === 'start') return;
  if (event === 'tool_call') {
    const card = addToolCard(activity, data.name, data.args);
    toolCards.set(data.name + ':' + (card._id = Math.random()), card);
    // сохраняем последнюю карточку по имени для результата
    asst._lastToolCard = card;
  } else if (event === 'tool_result') {
    // найти карточку по имени (последнюю)
    const cards = activity.querySelectorAll('.tool');
    let target = null;
    for (let i = cards.length - 1; i >= 0; i--) {
      const n = cards[i].querySelector('.name')?.textContent || '';
      if (n.includes(data.name)) { target = cards[i]; break; }
    }
    if (target) {
      const r = target.querySelector('[data-result]');
      if (r) {
        const preview = String(data.result || '');
        r.textContent = preview.length > 400 ? preview.slice(0, 400) + '…' : preview;
        r.style.color = data.ok ? 'var(--muted)' : 'var(--danger)';
      }
    }
  } else if (event === 'final') {
    // удалить activity? оставить
    // очистить bubble от activity временно? activity уже child; final text перед activity
    const finalText = data.answer || '';
    // Пересобрать bubble: текст + activity
    asst.bubble.innerHTML = simpleMarkdown(finalText) + (activity.outerHTML || '');
    // восстановить ссылки? activity detached → пересобираем ссылку
    // Лучше: оставляем как есть: просто дописываем текст перед activity
  } else if (event === 'error') {
    setBubbleContent(asst.bubble, `Ошибка: ${data.message}`);
  } else if (event === 'done') {
    // ничего
  }
}

// Улучшенный финальный рендер: при final вставляем текст ДО activity
const _origHandle = handleEvent;
// Переопределяем final handling cleanly:
handleEvent = function(event, data, asst, activity, toolCards) {
  if (event === 'final') {
    const finalText = data.answer || '';
    const wrapper = document.createElement('div');
    wrapper.innerHTML = simpleMarkdown(finalText);
    // вставить текст перед activity
    asst.bubble.insertBefore(wrapper, activity);
    activity.classList.add('done');
    return;
  }
  return _origHandle(event, data, asst, activity, toolCards);
};

sendBtn.addEventListener('click', send);
inputEl.addEventListener('keydown', (e) => {
  if (e.key === 'Enter' && !e.shiftKey) {
    e.preventDefault();
    send();
  }
});
// авто-рост textarea
inputEl.addEventListener('input', () => {
  inputEl.style.height = 'auto';
  inputEl.style.height = Math.min(inputEl.scrollHeight, 160) + 'px';
});

loadConfig();
