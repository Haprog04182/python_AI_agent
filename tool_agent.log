import subprocess,re,math

def load_alpha_mask(path):
    out=subprocess.check_output(['convert',path,'-alpha','extract','txt:-'],text=True)
    W=H=None
    pix={}
    w=h=0
    for ln in out.splitlines():
        if ln.startswith('# ImageMagick pixel enumeration'):
            # parse W,H
            parts=ln.split(':')[1].strip().split(',')
            w=int(parts[0]); h=int(parts[1])
        m=re.match(r'^(\d+),(\d+): \(([^)]+)\)', ln)
        if m:
            x=int(m.group(1)); y=int(m.group(2))
            v=float(m.group(3).split(',')[0])
            pix[(x,y)]=1 if v>128 else 0
    grid=[[pix.get((x,y),0) for x in range(w)] for y in range(h)]
    return grid,w,h

def largest_comp(grid,w,h):
    seen=[[0]*w for _ in range(h)]
    cid=0; best=None
    for sy in range(h):
        for sx in range(w):
            if grid[sy][sx] and seen[sy][sx]==0:
                cid+=1; stack=[(sx,sy)]; seen[sy][sx]=cid; comp=[]
                while stack:
                    x,y=stack.pop(); comp.append((x,y))
                    for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
                        nx,ny=x+dx,y+dy
                        if 0<=nx<w and 0<=ny<h and grid[ny][nx] and seen[ny][nx]==0:
                            seen[ny][nx]=cid; stack.append((nx,ny))
                if best is None or len(comp)>len(best[1]): best=(cid,comp)
    return best[1]

# original main comp
out=subprocess.check_output(['convert','preview.jpg','txt:-'],text=True)
W,H=299,168
gridorig=[[0]*W for _ in range(H)]
color={}
for ln in out.splitlines():
    m=re.match(r'^(\d+),(\d+): \(([^)]+)\)', ln)
    if m:
        x=int(m.group(1)); y=int(m.group(2)); v=[float(t) for t in m.group(3).split(',')]
        color[(x,y)]=v
        if sum(v)/3 < 130: gridorig[y][x]=1
seen=[[0]*W for _ in range(H)]
cid=0; best=None
for sy in range(H):
 for sx in range(W):
  if gridorig[sy][sx] and seen[sy][sx]==0:
    cid+=1; stack=[(sx,sy)]; seen[sy][sx]=cid; comp=[]
    while stack:
        x,y=stack.pop(); comp.append((x,y))
        for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
            nx,ny=x+dx,y+dy
            if 0<=nx<W and 0<=ny<H and gridorig[ny][nx] and seen[ny][nx]==0:
                seen[ny][nx]=cid; stack.append((nx,ny))
    if best is None or len(comp)>len(best[1]): best=(cid,comp)
origcomp=best[1]
oxs=[p[0] for p in origcomp]; oys=[p[1] for p in origcomp]
ox0,ox1=min(oxs),max(oxs); oy0,oy1=min(oys),max(oys)
origmask=[[0]*(ox1-ox0+1) for _ in range(oy1-oy0+1)]
for (x,y) in origcomp:
    origmask[y-oy0][x-ox0]=1
OW=len(origmask[0]); OH=len(origmask)
print("orig bbox",OW,OH)

for name in ['front','right','left','side','top']:
    grid,w,h=load_alpha_mask(f"/tmp/render_monkey_{name}.png")
    comp=largest_comp(grid,w,h)
    xs=[p[0] for p in comp]; ys=[p[1] for p in comp]
    x0,x1=min(xs),max(xs); y0,y1=min(ys),max(ys)
    bw=x1-x0+1; bh=y1-y0+1
    # nearest resize comp mask to (OW,OH)
    smask=[[0]*bw for _ in range(bh)]
    for (x,y) in comp:
        smask[y-y0][x-x0]=1
    # resize
    rmask=[[0]*OW for _ in range(OH)]
    for ry in range(OH):
        for rx in range(OW):
            # inverse
            sx=int(rx* (bw/OW)); sy=int(ry*(bh/OH))
            sx=min(sx,bw-1); sy=min(sy,bh-1)
            rmask[ry][rx]=smask[sy][sx]
    # IoU
    inter=sum(1 for y in range(OH) for x in range(OW) if origmask[y][x] and rmask[y][x])
    union=sum(1 for y in range(OH) for x in range(OW) if origmask[y][x] or rmask[y][x])
    print(f"{name}: render bbox {bw}x{bh}, IoU (nearest) = {inter/union:.3f}")
