}

* { box-sizing: border-box; }
html, body { margin:0; padding:0; height:100%; font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif; background: var(--bg); color: var(--text); }
.app { display:flex; flex-direction:column; height:100vh; max-width:1200px; margin:0 auto; }

.topbar {
  display:flex; align-items:center; justify-content:space-between; gap:12px;
