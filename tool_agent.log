import bpy, random, math
random.seed(7)

OUTDIR = "/home/teacher_haprog/models"
BLEND = OUTDIR + "/wizard.blend"
GLB = OUTDIR + "/wizard.glb"

# Clear scene
bpy.ops.object.select_all(action='SELECT')
bpy.ops.object.delete(use_global=False)
for block in (bpy.data.meshes, bpy.data.materials, bpy.data.cameras, bpy.data.lights):
    for b in list(block):
        block.remove(b)

scene = bpy.context.scene
scene.render.engine = 'BLENDER_EEVEE'
scene.eevee.taa_render_samples = 64 if hasattr(scene.eevee,'taa_render_samples') else 32

# ---- Materials helpers ----
def hex_to_rgb(h):
    h=h.lstrip('#')
    return tuple(int(h[i:i+2],16)/255.0 for i in (0,2,4))

def make_toon_material(name, base, rim_color=(1,1,1), emit=0.0, specular=0.3):
    mat = bpy.data.materials.new(name)
    mat.use_nodes = True
    nt = mat.node_tree
    nodes = nt.nodes; links = nt.links
    nodes.clear()
    bsdf = nodes.new('ShaderNodeBsdfToon')
    bsdf.inputs['Color'].default_value = (*hex_to_rgb(base) if isinstance(base,str) and base.startswith('#') else base, 1)
    bsdf.inputs['Size'].default_value = 0.45
    bsdf.inputs['Smooth'].default_value = 0.05
    # rim via fresnel
    fresnel = nodes.new('ShaderNodeFresnel')
    fresnel.inputs['IOR'].default_value = 1.3
    ramp = nodes.new('ShaderNodeValToRGB')
    ramp.color_ramp.elements[0].position = 0.6
    ramp.color_ramp.elements[0].color = (0,0,0,1)
    ramp.color_ramp.elements[1].position = 1.0
    rc = rim_color if not isinstance(rim_color,str) else hex_to_rgb(rim_color)
    ramp.color_ramp.elements[1].color = (*rc,1)
    # mix toon with emission rim
    em = nodes.new('ShaderNodeEmission')
    em.inputs['Color'].default_value = (*rc,1)
    em.inputs['Strength'].default_value = 2.5
    mix = nodes.new('ShaderNodeMixShader')
    out = nodes.new('ShaderNodeOutputMaterial')
    links.new(bsdf.outputs['BSDF'], mix.inputs[1])
    links.new(em.outputs['Emission'], mix.inputs[2])
    links.new(fresnel.outputs['Fac'], ramp.inputs['Fac'])
    links.new(ramp.outputs['Color'], mix.inputs['Fac'])
    links.new(mix.outputs['Shader'], out.inputs['Surface'])
    # slightly metallic? no
    return mat

def make_emissive_material(name, color, strength=5.0):
    mat = bpy.data.materials.new(name)
    mat.use_nodes = True
    nt = mat.node_tree
    nodes=nt.nodes; links=nt.links
    nodes.clear()
    em = nodes.new('ShaderNodeEmission')
    c = hex_to_rgb(color) if (isinstance(color,str) and color.startswith('#')) else color
    em.inputs['Color'].default_value = (*c,1)
    em.inputs['Strength'].default_value = strength
    out = nodes.new('ShaderNodeOutputMaterial')
    links.new(em.outputs['Emission'], out.inputs['Surface'])
    mat.blend_method = 'BLEND'
    return mat

outline_mat = bpy.data.materials.new('OutlineBlack')
outline_mat.use_nodes=True
nt=outline_mat.node_tree; nodes=nt.nodes; links=nt.links; nodes.clear()
bsdf=nodes.new('ShaderNodeBsdfDiffuse'); bsdf.inputs['Color'].default_value=(0,0,0,1)
out=nodes.new('ShaderNodeOutputMaterial'); links.new(bsdf.outputs['BSDF'],out.inputs['Surface'])

# ---- Primitives helpers ----
def add_sphere(name, loc, scale=(1,1,1), r=1.0, mat=None, smooth=True):
    bpy.ops.mesh.primitive_uv_sphere_add(radius=r, location=loc, segments=32, ring_count=16)
    obj=bpy.context.active_object; obj.name=name
    obj.scale=scale
    if mat: 
        obj.data.materials.append(mat)
    if smooth:
        for f in obj.data.polygons: f.use_smooth=True
    return obj

def add_cyl(name, loc, rot=(0,0,0), r=0.1, depth=1.0, mat=None):
    bpy.ops.mesh.primitive_cylinder_add(radius=r, depth=depth, location=loc, rotation=rot, vertices=24)
    obj=bpy.context.active_object; obj.name=name
    if mat: obj.data.materials.append(mat)
    for f in obj.data.polygons: f.use_smooth=True
    return obj

def add_cone(name, loc, rot=(0,0,0), r1=0.3, r2=0.0, depth=1.0, mat=None):
    bpy.ops.mesh.primitive_cone_add(radius1=r1, radius2=r2, depth=depth, location=loc, rotation=rot, vertices=24)
    obj=bpy.context.active_object; obj.name=name
    if mat: obj.data.materials.append(mat)
    for f in obj.data.polygons: f.use_smooth=True
    return obj

def add_ico(name, loc, r=0.05, mat=None):
    bpy.ops.mesh.primitive_ico_sphere_add(radius=r, location=loc, subdivisions=2)
    obj=bpy.context.active_object; obj.name=name
    if mat: obj.data.materials.append(mat)
    for f in obj.data.polygons: f.use_smooth=True
    return obj

# ---- Materials palette ----
mat_robe = make_toon_material('Robe', '#4B2C6F', rim_color='#9B6FD6')
mat_skin = make_toon_material('Skin', '#FFD7B5', rim_color='#FFFFFF')
mat_hat  = make_toon_material('Hat',  '#2B1B3D', rim_color='#6B4FA0')
mat_boot = make_toon_material('Boot', '#1A120B', rim_color='#5A3A1F')
mat_wood = make_toon_material('Wood', '#8B5A2B', rim_color='#D4A060')
mat_orb  = make_emissive_material('Orb', '#00FFFF', strength=6.0)
mat_magic= make_emissive_material('Magic', '#7DF9FF', strength=8.0)
mat_eye  = make_toon_material('Eye', '#0A0A0A', rim_color='#FFFFFF')

# ---- Build wizard ----
# Body robe
body = add_sphere('Body', (0,0,1.05), scale=(0.85,0.75,1.25), r=0.7, mat=mat_robe)
# skirt (cone)
skirt = add_cone('Skirt', (0,0,0.55), r1=0.9, r2=0.4, depth=1.0, mat=mat_robe)
# head
head = add_sphere('Head', (0,0,2.25), r=0.5, mat=mat_skin)
# hat
hat = add_cone('Hat', (0,0,2.85), r1=0.62, r2=0.0, depth=1.0, mat=mat_hat)
# beard
beard = add_cone('Beard', (0,0.38,2.0), rot=(1.2,0,0), r1=0.28, r2=0.0, depth=0.6, mat=mat_skin)
# arms
armL = add_cyl('ArmL', (-0.72,0,1.9), rot=(0,0.4,0.6), r=0.11, depth=0.85, mat=mat_robe)
armR = add_cyl('ArmR', (0.72,0.15,2.0), rot=(0,-0.45,0.3), r=0.11, depth=0.85, mat=mat_robe)
# hands
handL = add_sphere('HandL', (-0.95,-0.15,1.55), r=0.12, mat=mat_skin)
handR = add_sphere('HandR', (0.95,0.35,1.68), r=0.12, mat=mat_skin)
# legs
legL = add_cyl('LegL', (-0.28,0,0.5), r=0.13, depth=0.9, mat=mat_robe)
legR = add_cyl('LegR', (0.28,0,0.5), r=0.13, depth=0.9, mat=mat_robe)
# boots
bootL = add_sphere('BootL', (-0.28,0.08,0.05), scale=(1,1.3,0.6), r=0.16, mat=mat_boot)
bootR = add_sphere('BootR', (0.28,0.08,0.05), scale=(1,1.3,0.6), r=0.16, mat=mat_boot)
# eyes
eyeL = add_sphere('EyeL', (-0.18,0.42,2.32), r=0.06, mat=mat_eye)
eyeR = add_sphere('EyeR', (0.18,0.42,2.32), r=0.06, mat=mat_eye)
# staff
staff = add_cyl('Staff', (0.95,0.3,1.1), r=0.055, depth=2.2, mat=mat_wood)
# orb at staff top
orb = add_sphere('Orb', (0.95,0.3,2.25), r=0.18, mat=mat_orb)

# ---- Magic particles as small spheres ----
top = (0.95,0.3,2.3)
N=140
for i in range(N):
    t = i / (N-1)
    h = t*1.6
    ang = t*6.0*math.pi + random.uniform(-0.3,0.3)
    rad = 0.05 + t*0.55 + random.uniform(-0.05,0.05)
    x = top[0] + math.cos(ang)*rad
    y = top[1] + math.sin(ang)*rad
    z = top[2] + h + random.uniform(-0.05,0.05)
    r = 0.025 + random.random()*0.04
    # occasional trailing spark
    spark = add_ico(f'Spark_{i}', (x,y,z), r=r, mat=mat_magic)
    spark.scale = (0.6+random.random()*0.8,)*3

# ---- Outline shells for solid parts (exclude sparks, orb?) ----
solids = [o for o in bpy.context.scene.objects if o.type=='MESH' and not o.name.startswith('Spark')]
for obj in solids:
    bpy.context.view_layer.objects.active = obj
    bpy.ops.object.select_all(action='DESELECT')
    obj.select_set(True)
    bpy.ops.object.duplicate()
    dup = bpy.context.active_object
    dup.name = obj.name + '_outline'
    # scale around object's own center
    dup.scale = (1.04,1.04,1.04)
    bpy.ops.object.transform_apply(location=False, rotation=False, scale=True)
    # flip normals
    bpy.ops.object.mode_set(mode='EDIT')
    bpy.ops.mesh.select_all(action='SELECT')
    bpy.ops.mesh.flip_normals()
    bpy.ops.object.mode_set(mode='OBJECT')
    dup.data.materials.clear()
    dup.data.materials.append(outline_mat)
    bpy.ops.object.select_all(action='DESELECT')

# Rename spark outlines? none.

# ---- Lighting & Camera ----
# key light
bpy.ops.object.light_add(type='SUN', location=(5,-5,8))
key=bpy.context.active_object; key.data.energy=3.0; key.rotation_euler=(0.6,0,0.8)
bpy.ops.object.light_add(type='AREA', location=(-4,3,4))
fill=bpy.context.active_object; fill.data.energy=120; fill.data.size=3
bpy.ops.object.light_add(type='POINT', location=(1,0,3.5))
rim=bpy.context.active_object; rim.data.energy=200; rim.data.color=(0.6,0.8,1)
# camera
bpy.ops.object.camera_add(location=(4.5,-4.5,2.8))
cam=bpy.context.active_object
cam.rotation_euler=(1.2,0,0.8)
scene.camera=cam
# world bg
world = bpy.data.worlds.new('World')
scene.world = world
world.use_nodes=True
wn=world.node_tree.nodes; wl=world.node_tree.links; wn.clear()
bg=wn.new('ShaderNodeBackground'); bg.inputs['Color'].default_value=(0.12,0.10,0.18,1)
bg.inputs['Strength'].default_value=0.6
outw=wn.new('ShaderNodeOutputWorld'); wl.new(bg.outputs['Background'],outw.inputs['Surface'])

# Apply scale transforms for all meshes
bpy.ops.object.select_all(action='SELECT')
bpy.ops.object.transform_apply(location=False, rotation=True, scale=True)
bpy.ops.object.select_all(action='DESELECT')

# Save blend
bpy.ops.wm.save_as_mainfile(filepath=BLEND)
# Export GLB
bpy.ops.export_scene.gltf(
    filepath=GLB,
    export_format='GLB',
    export_materials='EXPORT',
    export_cameras=True,
    export_lights=True,
    use_selection=False)
print("DONE", BLEND, GLB)
