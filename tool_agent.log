for sp in sparks:
    spark_orig_scales[sp.name] = tuple(sp.scale[:])
    sp.parent = pivot
    sp.matrix_parent_inverse = pivot.matrix_world.inverted() @ sp.matrix_world

# ---- Keyframes (casting animation) ----
scene.frame_start = 1
scene.frame_end = 96
scene.render.fps = 24

def kf_loc(obj, frame, loc):
    obj.location = loc
    obj.keyframe_insert(data_path='location', frame=frame)
def kf_rot(obj, frame, rot):
    obj.rotation_euler = rot
    obj.keyframe_insert(data_path='rotation_euler', frame=frame)
def kf_scale(obj, frame, sc):
    obj.scale = sc
    obj.keyframe_insert(data_path='scale', frame=frame)
def kf_emission(mat, frame, strength):
    n = mat.node_tree.nodes.get('Emission')
    if n:
        n.inputs['Strength'].default_value = strength
        n.inputs['Strength'].keyframe_insert(data_path='default_value', frame=frame)

# helper for orb norm material node
# Frame poses
# Frame 1: rest
kf_rot(armR, 1, (0, -0.45, 0.3))
kf_loc(armR, 1, (0.72,0.15,2.0))
kf_loc(handR, 1, (0.95,0.35,1.68))
kf_rot(staff, 1, (0,0,0))
kf_loc(staff, 1, (0.95,0.3,1.1))
kf_rot(pivot, 1, (0,0,0))
for sp in sparks:
    kf_scale(sp, 1, (0,0,0))
kf_emission(mat_orb, 1, 20.0)

# Frame 40: raising
kf_rot(armR, 40, (0, -0.9, 0.3))
kf_loc(armR, 40, (0.6,0.25,2.15))
kf_loc(handR, 40, (0.8,0.3,1.9))
kf_rot(staff, 40, (-0.4,0,0))
kf_loc(staff, 40, (0.85,0.3,1.45))
kf_rot(pivot, 40, (0,0,2*math.pi))
for sp in sparks:
    s0 = spark_orig_scales[sp.name]
    kf_scale(sp, 40, (s0[0]*0.35, s0[1]*0.35, s0[2]*0.35))
kf_emission(mat_orb, 40, 80.0)

# Frame 80: cast
kf_rot(armR, 80, (0, -1.35, 0.3))
kf_loc(armR, 80, (0.55,0.35,2.25))
kf_loc(handR, 80, (0.7,0.35,2.0))
kf_rot(staff, 80, (-0.9,0,0))
kf_loc(staff, 80, (0.75,0.3,1.65))
kf_rot(pivot, 80, (0,0,6*math.pi))
for sp in sparks:
    s0 = spark_orig_scales[sp.name]
    kf_scale(sp, 80, s0)
kf_emission(mat_orb, 80, 200.0)

# Frame 96: hold
kf_rot(armR, 96, (0, -1.35, 0.3))
kf_loc(armR, 96, (0.55,0.35,2.25))
kf_rot(staff, 96, (-0.9,0,0))
kf_loc(staff, 96, (0.75,0.3,1.65))
kf_rot(pivot, 96, (0,0,6*math.pi))
for sp in sparks:
